{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://live-rig.local/schemas/scene.schema.json",
  "title": "Live Rig Scene System",
  "type": "object",
  "required": [
    "rig_name",
    "profile_name",
    "version",
    "scenes"
  ],
  "properties": {
    "rig_name": {
      "type": "string",
      "minLength": 1
    },
    "profile_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "notes": {
      "type": "string"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "scene": {
      "type": "object",
      "required": [
        "id",
        "label",
        "ramp_ms",
        "hard_override",
        "params",
        "triggers"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(scene|state)\\.[a-z0-9_.]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "ramp_ms": {
          "type": "integer",
          "minimum": 0
        },
        "hard_override": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        },
        "params": {
          "type": "object"
        },
        "analysis": {
          "$ref": "#/$defs/analysis"
        },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/trigger"
          }
        }
      },
      "additionalProperties": false
    },
    "analysis": {
      "type": "object",
      "properties": {
        "influence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "weights": {
          "$ref": "#/$defs/analysisWeights"
        }
      },
      "anyOf": [
        {
          "required": [
            "influence"
          ]
        },
        {
          "required": [
            "weights"
          ]
        }
      ],
      "additionalProperties": false
    },
    "analysisWeights": {
      "type": "object",
      "properties": {
        "low_band": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mid_band": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "upper_mid_band": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "high_band": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "trigger": {
      "oneOf": [
        {
          "$ref": "#/$defs/midiNoteTrigger"
        },
        {
          "$ref": "#/$defs/midiCcTrigger"
        },
        {
          "$ref": "#/$defs/oscTrigger"
        }
      ]
    },
    "midiNoteTrigger": {
      "type": "object",
      "required": [
        "type",
        "channel",
        "note"
      ],
      "properties": {
        "type": {
          "const": "midi_note"
        },
        "channel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "note": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "velocity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        }
      },
      "additionalProperties": false
    },
    "midiCcTrigger": {
      "type": "object",
      "required": [
        "type",
        "channel",
        "cc"
      ],
      "properties": {
        "type": {
          "const": "midi_cc"
        },
        "channel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "cc": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        }
      },
      "additionalProperties": false
    },
    "oscTrigger": {
      "type": "object",
      "required": [
        "type",
        "address"
      ],
      "properties": {
        "type": {
          "const": "osc"
        },
        "address": {
          "type": "string",
          "pattern": "^/"
        },
        "args": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "additionalProperties": false
    }
  }
}
